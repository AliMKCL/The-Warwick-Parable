# Copy this file to .env.local and adjust. .env.local is never committed.

# Which model server to use: "ollama" (default) or "openai" (LM Studio, mlx_lm.server, or a cloud API).
#LLM_PROVIDER=ollama

# Where it listens. Ollama: http://127.0.0.1:11434   LM Studio: http://127.0.0.1:1234
# Offline (Ollama): LLM_PROVIDER=ollama, LLM_BASE_URL=http://127.0.0.1:11434, LLM_MODEL=qwen3.6:35b-a3b, LLM_PARALLEL=1

# Model name exactly as the server knows it.
# Ollama:    qwen3.6:35b-a3b
# LM Studio: qwen3.6-35b-a3b  (check the name shown in LM Studio's server tab)
# LLM_MODEL=qwen3.6:35b-a3b

# Only for a cloud fallback through the "openai" provider. Leave empty for local models.

#ELEVENLABS_API_KEY=sk_5eadceacb25002d9ff0d7000a7d0389970609e39ba41a3bd
ELEVENLABS_VOICE_ID=pqHfZKP75CvOlQylNhV4

# Rooms generated at once; match the server setting (docs/speed.md)
#LLM_PARALLEL=1


LLM_PROVIDER=openai
LLM_BASE_URL=https://openrouter.ai/api
LLM_MODEL=qwen/qwen3.6-35b-a3b
LLM_API_KEY=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.
LLM_PARALLEL=3
