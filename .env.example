# Copy this file to .env.local and adjust. .env.local is never committed.
# Restart `npm run dev` after any change: it reads this file only when it starts,
# and prints "Rooms written by: ..." so you can see which model is in use.

# ---- Which model writes the rooms ----
# openrouter = cloud, fastest, needs internet and a key
# ollama     = local, works offline
# lmstudio   = local, through LM Studio's server
MODEL_BACKEND=ollama

# Rooms generated at the same time. 3 for OpenRouter; 1 for Ollama unless you set
# OLLAMA_NUM_PARALLEL (see docs/speed.md); LM Studio: its "Max Concurrent Predictions".
PARALLEL_ROOMS=1

# ---- OpenRouter (cloud) ----
# Key from https://openrouter.ai/keys. The dev server adds it to requests; it never reaches the browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.6-35b-a3b

# ---- Ollama (local) ----
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6:35b-a3b

# ---- LM Studio (local) ----
LMSTUDIO_URL=http://127.0.0.1:1234
# The model's API identifier, shown in LM Studio's Developer tab.
LMSTUDIO_MODEL=

# ---- Narrator voice (optional, ElevenLabs) ----
# Leave the key empty to keep the narrator silent (subtitles only). See docs/voice.md.
ELEVENLABS_API_KEY=
# Default: "George", a built-in British storyteller that works on every plan. Voice-library voices
# (e.g. "Older Joe" qxePw1S1QmBgjlU3GIy5) need a paid plan to be used through the API.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 = fastest, half the credits. eleven_multilingual_v2 = richer delivery, slower.
ELEVENLABS_MODEL=eleven_flash_v2_5
# Stop speaking after this many characters per page load, to protect your credits.
ELEVENLABS_MAX_CHARS=6000

# ---- Play-data collection (optional, Supabase) ----
# Leave empty to collect nothing. Tables: run supabase/schema.sql once in the Supabase SQL editor.
# Players are asked for consent on the start screen; no personal information is stored. `npm run analyze` reads it back.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
