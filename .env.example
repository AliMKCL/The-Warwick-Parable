# Copy this file to .env.local and adjust. .env.local is never committed.

# Which model server to use: "ollama" (default) or "openai" (LM Studio, mlx_lm.server, or a cloud API).
LLM_PROVIDER=ollama

# Where it listens. Ollama: http://127.0.0.1:11434   LM Studio: http://127.0.0.1:1234
LLM_BASE_URL=http://127.0.0.1:11434

# Model name exactly as the server knows it.
# Ollama:    qwen3.6:35b-a3b
# LM Studio: qwen3.6-35b-a3b  (check the name shown in LM Studio's server tab)
LLM_MODEL=qwen3.6:35b-a3b

# How many rooms to generate at the same time. Match it to the server's parallel setting:
# Ollama: OLLAMA_NUM_PARALLEL (see docs/speed.md). LM Studio: "Max Concurrent Predictions".
# Leave at 1 if the server runs one request at a time.
LLM_PARALLEL=1

# Only for a cloud model through the "openai" provider. Leave empty for local models.
# The dev server adds it to requests; it never reaches the browser.
LLM_API_KEY=

# ---- Cloud instead of local (faster; needs internet). See docs/speed.md ----
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api
# LLM_MODEL=qwen/qwen3.6-35b-a3b
# LLM_API_KEY=sk-or-...
# LLM_PARALLEL=3

# ---- Narrator voice (optional, ElevenLabs) ----
# Leave the key empty to keep the narrator silent (subtitles only). See docs/voice.md.
ELEVENLABS_API_KEY=
# Default: "George", a built-in British storyteller that works on every plan. Voice-library voices
# (e.g. "Older Joe" qxePw1S1QmBgjlU3GIy5) need a paid plan to be used through the API.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 = fastest, half the credits. eleven_multilingual_v2 = richer delivery, slower.
ELEVENLABS_MODEL=eleven_flash_v2_5
# Stop speaking after this many characters per page load, to protect your credits.
ELEVENLABS_MAX_CHARS=6000
